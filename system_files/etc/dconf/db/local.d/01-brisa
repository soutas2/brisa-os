# Brisa OS — definições por omissão (cada utilizador pode mudar nas Definições)

# --- Aparência tipo macOS -------------------------------------------------
[org/gnome/desktop/interface]
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
font-antialiasing='grayscale'
font-hinting='slight'
color-scheme='prefer-dark'
accent-color='blue'
clock-show-weekday=true
show-battery-percentage=true
enable-hot-corners=false

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:appmenu'
titlebar-font='Inter Semi-Bold 11'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/brisa/brisa-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/brisa/brisa-dark.svg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/brisa/brisa-dark.svg'

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['org.mozilla.firefox.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']

# Dock em baixo, como no Mac, com ícones grandes para o dedo
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
extend-height=false
height-fraction=0.9
dash-max-icon-size=56
icon-size-fixed=true
show-trash=false
show-mounts=false
show-show-apps-button=true
show-apps-at-top=false
running-indicator-style='DOTS'
apply-custom-theme=false
custom-theme-shrink=true
transparency-mode='FIXED'
background-opacity=0.55
click-action='minimize-or-previews'
hot-keys=false
disable-overview-on-startup=true

# Desfoque leve só no painel e na dock (estático = quase sem custo de GPU)
[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
static-blur=true

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true
static-blur=true

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=false

# --- Ecrã e touch ---------------------------------------------------------
[org/gnome/mutter]
experimental-features=['scale-monitor-framebuffer', 'xwayland-native-scaling']
dynamic-workspaces=true
edge-tiling=true

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true
two-finger-scrolling-enabled=true

# --- Terminal pronto para Claude Code ------------------------------------
[org/gnome/Ptyxis]
use-system-font=false
font-name='JetBrains Mono 13'
restore-session=false

# --- Energia --------------------------------------------------------------
[org/gnome/settings-daemon/plugins/power]
sleep-inactive-battery-timeout=900
sleep-inactive-ac-timeout=1800
power-button-action='suspend'

[org/gnome/desktop/session]
idle-delay=uint32 300

# --- Poupança de RAM e CPU -----------------------------------------------
# Indexação de ficheiros desligada (é o que mais pesa num CPU fraco)
[org/freedesktop/tracker/miner/files]
index-recursive-directories=@as []
index-single-directories=@as []
enable-monitors=false
crawling-interval=-2

# Pesquisa da vista geral sem abrir apps em segundo plano
[org/gnome/desktop/search-providers]
disable-external=true

[org/gnome/software]
download-updates=false
